[0.824648, "o", "\r\n  \u001b[1msimvader\u001b[0m  virtual patching for MCP\r\n\r\n"]
[0.864891, "o", "  \u001b[2m* client connected -> 2 tools behind the gateway\u001b[0m\r\n\r\n   \u001b[2m>\u001b[0m fetch(url=https://news.google.com)\r\n"]
[1.400017, "o", "      \u001b[32mallowed\u001b[0m  \u001b[2m-> FETCHED: https://news.google.com\u001b[0m\r\n"]
[2.207653, "o", "   \u001b[2m>\u001b[0m fetch(url=http://169.254.169.254/latest/meta-data/)   \u001b[33m<- prompt-injected SSRF\u001b[0m\r\n"]
[2.740034, "o", "      \u001b[31m\u001b[1mBLOCKED\u001b[0m  \u001b[31mServer-Side Request Forgery (CWE-918)\u001b[0m\r\n"]
[3.547368, "o", "   \u001b[2m>\u001b[0m run_command(cmd=ls; cat /etc/passwd)   \u001b[33m<- command injection\u001b[0m"]
[3.548319, "o", "\r\n"]
[4.081694, "o", "      \u001b[31m\u001b[1mBLOCKED\u001b[0m  \u001b[31mOS Command Injection (CWE-78)\u001b[0m\r\n"]
[4.887431, "o", "   \u001b[2m>\u001b[0m run_command(cmd=ls -la)\r\n"]
[5.423922, "o", "      \u001b[32mallowed\u001b[0m  \u001b[2m-> RAN: ls -la\u001b[0m\r\n"]
[6.230621, "o", "\r\n  \u001b[1maudit log\u001b[0m (one JSON line per call, ship it anywhere):\r\n"]
